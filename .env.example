# Pick ONE backend: groq | openrouter | hf | ollama
LLM_BACKEND=groq

# --- Groq (free tier, no credit card): https://console.groq.com/keys ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=qwen/qwen3.8-27b

# --- OpenRouter (free models end in :free, ~50 requests/day): https://openrouter.ai/keys ---
# OPENROUTER_API_KEY=sk-or-xxxxxxxx
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Hugging Face hosted (needs credits) ---
# HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxx
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Local Ollama (free, offline) ---
# OLLAMA_MODEL=llama3.2:3b

# false = run with keyword/rule fallback only
USE_LLM=true
